PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Prisma CLI uses the database owner; the running API uses a non-owner role.
MIGRATION_DATABASE_URL=postgresql://threadline_owner:CHANGE_ME@localhost:5432/threadline
DATABASE_URL=postgresql://threadline_app:CHANGE_ME@localhost:5432/threadline

# Cloudflare R2 S3-compatible API. Keep the bucket private.
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=threadline-private
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# SMTP for verification and password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Threadline <no-reply@example.com>"

# Generate with `openssl rand -base64 32`.
MFA_ENCRYPTION_KEY=
