# Public site URL configured on Coolify (use HTTPS even while using sslip.io)
FRONTEND_URL=https://threadline.187.127.204.124.sslip.io
THREADLINE_API_URL=http://api:3001

# PostgreSQL. Use URL-safe passwords or percent-encode reserved URL characters.
POSTGRES_USER=threadline_owner
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
THREADLINE_APP_PASSWORD=CHANGE_ME_LONG_RANDOM

# SMTP is required for registration verification and password reset links.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Threadline <no-reply@example.com>"

# Optional one-time bootstrap for the first Super Admin. Remove after first startup.
INITIAL_SUPER_ADMIN_EMAIL=
INITIAL_SUPER_ADMIN_NAME=
INITIAL_SUPER_ADMIN_PASSWORD=

# Cloudflare R2 S3-compatible API. The bucket must remain private.
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=threadline-private
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Generate with `openssl rand -base64 32`. Protects Super Admin TOTP secrets.
MFA_ENCRYPTION_KEY=
